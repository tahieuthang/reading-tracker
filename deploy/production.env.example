# Copy to .env.production at the repository root and replace every example value.
DOMAIN=books.example.com
LETSENCRYPT_EMAIL=admin@example.com

MYSQL_DATABASE=reading_tracker
MYSQL_USER=reading_tracker
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_password

# Percent-encode reserved URL characters in the username or password.
DATABASE_URL=mysql://reading_tracker:replace_with_a_long_random_password@db:3306/reading_tracker
OPEN_LIBRARY_USER_AGENT=ReadingTracker/1.0 (contact: admin@example.com)
LOG_LEVEL=info
