{
  "name": "@reading-tracker/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/modules/shelf/shelf-rules.test.ts tests/contract/http-contract.test.ts src/modules/books/open-library-client.test.ts",
    "test:integration": "tsx --test tests/integration/shelf-api.integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pm2": "^7.0.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "prisma": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
